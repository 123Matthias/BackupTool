<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="my.backup.backupTool.Controller.SettingsController"
      prefHeight="400.0" prefWidth="600.0"
      alignment="TOP_LEFT"
      styleClass="basicBackground">



    <VBox style="-fx-padding: 20">
        <Label styleClass="headerText" text="Themes: "/>
        <HBox spacing="20">
            <Button text="lightTheme" styleClass="basicButtonSettings" onAction="#handleLightTheme"/>
            <Button text="darkTheme" styleClass="basicButtonSettings" onAction="#handleDarkTheme"/>
        </HBox>
    </VBox>



</VBox>
