<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<AnchorPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="my.backup.backupTool.Controller.MessageController"
      prefHeight="450.0" prefWidth="350.0"
      fx:id="rootPane"
      styleClass="basicBackground">
        <VBox fx:id="container" spacing="5" styleClass="messageContainer" >
            <Label fx:id="messageType" styleClass="messageHeader"></Label>

        </VBox>

    <Button text="OK" AnchorPane.bottomAnchor="20" AnchorPane.rightAnchor="20" styleClass="standardButton" onAction="#closeStage"> </Button>


</AnchorPane>
